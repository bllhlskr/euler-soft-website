---
import BaseLayout from "../layouts/BaseLayout.astro";
import { apps } from "../data/apps";
import en from "../i18n/ui/en";
import { t } from "../i18n/utils";

const s = en;
---

<BaseLayout title="Contact Us — Euler Soft" description="Get in touch with Euler Soft for support, feedback, or business inquiries.">
    <section class="max-w-3xl mx-auto px-6 pt-16 pb-8 text-center">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900">{t(s, "contact.title")}</h1>
        <p class="mt-4 text-lg text-gray-500 max-w-xl mx-auto">{t(s, "contact.subtitle")}</p>
    </section>

    <section class="max-w-3xl mx-auto px-6 pb-20">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
            <div class="md:col-span-3">
                <form
                    action="https://formsubmit.co/eulersoft@outlook.com"
                    method="POST"
                    class="space-y-5"
                    id="contact-form"
                >
                    <input type="hidden" name="_captcha" value="false" />
                    <input type="hidden" name="_next" value="https://euler-soft.com/contact" />
                    <input type="hidden" name="_subject" value="Euler Soft Contact Form" />
                    <input type="text" name="_honey" style="display:none" />
                    <div>
                        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">{t(s, "contact.form.name")}</label>
                        <input
                            type="text"
                            name="name"
                            id="name"
                            required
                            class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-gray-400 focus:ring-0 transition-colors"
                            placeholder="John Doe"
                        />
                    </div>

                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">{t(s, "contact.form.email")}</label>
                        <input
                            type="email"
                            name="email"
                            id="email"
                            required
                            class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-gray-400 focus:ring-0 transition-colors"
                            placeholder="you@example.com"
                        />
                    </div>

                    <div>
                        <label for="app" class="block text-sm font-medium text-gray-700 mb-1">{t(s, "contact.form.app")}</label>
                        <select
                            name="app"
                            id="app"
                            class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-900 focus:border-gray-400 focus:ring-0 transition-colors bg-white"
                        >
                            <option value="">{t(s, "contact.form.app.none")}</option>
                            {apps.map((app) => (
                                <option value={app.name}>{app.name}</option>
                            ))}
                        </select>
                    </div>

                    <div>
                        <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">{t(s, "contact.form.subject")}</label>
                        <input
                            type="text"
                            name="subject"
                            id="subject"
                            required
                            class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-gray-400 focus:ring-0 transition-colors"
                        />
                    </div>

                    <div>
                        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">{t(s, "contact.form.message")}</label>
                        <textarea
                            name="message"
                            id="message"
                            rows="5"
                            required
                            class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-gray-400 focus:ring-0 transition-colors resize-y"
                        ></textarea>
                    </div>

                    <button
                        type="submit"
                        class="w-full rounded-xl bg-gray-900 px-6 py-3 text-sm font-medium text-white hover:bg-gray-800 transition-colors"
                    >
                        {t(s, "contact.form.send")}
                    </button>
                </form>

                <div id="form-success" class="hidden mt-6 rounded-xl border border-green-200 bg-green-50 p-5 text-center">
                    <p class="text-green-800 font-medium">{t(s, "contact.form.success")}</p>
                </div>
            </div>

            <div class="md:col-span-2 space-y-6">
                <div class="rounded-2xl border border-gray-100 bg-gray-50 p-6">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-full bg-gray-900 flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <h3 class="font-semibold text-gray-900">{t(s, "contact.email.label")}</h3>
                    </div>
                    <a
                        href="mailto:eulersoft@outlook.com"
                        class="text-blue-600 hover:text-blue-700 font-medium transition-colors"
                    >
                        eulersoft@outlook.com
                    </a>
                    <p class="mt-2 text-sm text-gray-500">{t(s, "contact.email.description")}</p>
                </div>

                <div class="rounded-2xl border border-gray-100 bg-gray-50 p-6">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-full bg-gray-900 flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="font-semibold text-gray-900">Response Time</h3>
                    </div>
                    <p class="text-sm text-gray-500">{t(s, "contact.response")}</p>
                </div>

                <div class="rounded-2xl border border-gray-100 bg-gray-50 p-6">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 rounded-full bg-gray-900 flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="font-semibold text-gray-900">FAQ</h3>
                    </div>
                    <p class="text-sm text-gray-500 mb-3">Check our support page for quick answers.</p>
                    <a
                        href="/support"
                        class="text-sm text-blue-600 hover:text-blue-700 font-medium transition-colors"
                    >
                        Visit Support Center &rarr;
                    </a>
                </div>
            </div>
        </div>
    </section>

    <script>
        const form = document.getElementById("contact-form") as HTMLFormElement;
        const successMsg = document.getElementById("form-success");

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = form.querySelector("button[type=submit]") as HTMLButtonElement;
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = "Sending...";

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { Accept: "application/json" },
                });

                if (response.ok) {
                    form.style.display = "none";
                    successMsg?.classList.remove("hidden");
                } else {
                    window.location.href = `mailto:eulersoft@outlook.com?subject=${encodeURIComponent(
                        (form.querySelector("#subject") as HTMLInputElement)?.value ?? "Support Request"
                    )}&body=${encodeURIComponent(
                        (form.querySelector("#message") as HTMLTextAreaElement)?.value ?? ""
                    )}`;
                }
            } catch {
                window.location.href = "mailto:eulersoft@outlook.com";
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        });
    </script>
</BaseLayout>
