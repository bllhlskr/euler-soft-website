---
import CatAtlasLegalPage from "../../../components/CatAtlasLegalPage.astro";
import { nonDefaultLocales, type Locale } from "../../../i18n/languages";

export function getStaticPaths() {
    return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
---

<CatAtlasLegalPage documentType="privacy" locale={lang} />
