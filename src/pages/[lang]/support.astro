---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apps } from "../../data/apps";
import { nonDefaultLocales, type Locale } from "../../i18n/languages";
import { loadTranslation, t, localePath } from "../../i18n/utils";

export function getStaticPaths() {
    return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const s = await loadTranslation(lang);

const appKeys = [
    "blood-sugar-tracker", "plant-identifier", "insect-identifier",
    "antique-identifier", "card-value-scanner", "blood-pressure-diary",
    "card-centering", "fasting-tracker", "class-planner", "pitch-counter", "pill-reminder",
];

const generalFaqKeys = ["q1", "q2", "q3", "q4", "q5", "q6"];

function getAppFaqs(appKey: string) {
    const faqs: { q: string; a: string }[] = [];
    for (let i = 1; i <= 5; i++) {
        const qKey = `faq.${appKey}.q${i}`;
        const aKey = `faq.${appKey}.a${i}`;
        if (s[qKey]) {
            faqs.push({ q: t(s, qKey), a: t(s, aKey) });
        }
    }
    return faqs;
}
---

<BaseLayout title={`${t(s, "support.title")} — Euler Soft`} description={t(s, "support.subtitle")} locale={lang}>
    <section class="max-w-3xl mx-auto px-6 pt-16 pb-8 text-center">
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900">{t(s, "support.title")}</h1>
        <p class="mt-4 text-lg text-gray-500 max-w-xl mx-auto">{t(s, "support.subtitle")}</p>
    </section>

    <section class="max-w-3xl mx-auto px-6 pb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">{t(s, "support.general")}</h2>
        <div class="space-y-4">
            {generalFaqKeys.map((key) => (
                <details class="group border border-gray-100 rounded-xl bg-white">
                    <summary class="flex items-center justify-between cursor-pointer rounded-xl p-5 text-left font-medium text-gray-900 transition-colors hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">
                        <span>{t(s, `faq.general.${key}`)}</span>
                        <svg class="ms-4 h-5 w-5 flex-shrink-0 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </summary>
                    <p class="px-5 pb-5 text-gray-500 leading-relaxed">{t(s, `faq.general.a${key.slice(1)}`)}</p>
                </details>
            ))}
        </div>
    </section>

    {appKeys.map((appKey) => {
        const faqs = getAppFaqs(appKey);
        if (faqs.length === 0) return null;
        const appName = t(s, `app.${appKey}.name`);
        const appIcon = apps.find((app) => app.slug === appKey)?.icon ?? "";
        return (
            <section class="max-w-3xl mx-auto px-6 pb-12">
                <div class="flex items-center gap-3 mb-6">
                    {appIcon && <img src={appIcon} alt="" width="40" height="40" class="rounded-[10px] shadow-sm" />}
                    <h2 class="text-2xl font-bold text-gray-900">{appName}</h2>
                </div>
                <div class="space-y-4">
                    {faqs.map((faq) => (
                        <details class="group border border-gray-100 rounded-xl bg-white">
                            <summary class="flex items-center justify-between cursor-pointer rounded-xl p-5 text-left font-medium text-gray-900 transition-colors hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">
                                <span>{faq.q}</span>
                                <svg class="ms-4 h-5 w-5 flex-shrink-0 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </summary>
                            <p class="px-5 pb-5 text-gray-500 leading-relaxed">{faq.a}</p>
                        </details>
                    ))}
                </div>
            </section>
        );
    })}

    <section class="max-w-3xl mx-auto px-6 pb-20 text-center">
        <div class="rounded-2xl border border-gray-100 bg-gray-50 p-8">
            <p class="text-gray-500 mb-4">{t(s, "contact.subtitle")}</p>
            <a
                href={localePath(lang, "/contact")}
                class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-gray-900 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-gray-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900"
            >
                {t(s, "nav.contact")}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </a>
        </div>
    </section>
</BaseLayout>
