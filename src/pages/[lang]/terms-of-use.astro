---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { nonDefaultLocales, type Locale } from "../../i18n/languages";
import { loadTranslation, t } from "../../i18n/utils";

export function getStaticPaths() {
    return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const s = await loadTranslation(lang);
const courtesyParts = t(s, "legal.courtesy").split("{link}");

let legalHtml: string | null = null;
try {
    const mod = await import(`../../i18n/legal/terms/${lang}.ts`);
    legalHtml = mod.default;
} catch {}
---

<BaseLayout title={`${t(s, "footer.terms")} — Euler Soft`} description={t(s, "site.description")} locale={lang}>
    <article class="max-w-3xl mx-auto px-6 py-16 prose prose-gray">
        {!legalHtml && (
            <div class="not-prose mb-8 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
                {courtesyParts[0]}
                <a href="/terms-of-use" class="font-medium underline">{t(s, "legal.courtesy.link")}</a>
                {courtesyParts[1]}
            </div>
        )}
        {legalHtml ? <Fragment set:html={legalHtml} /> : null}
    </article>
</BaseLayout>
