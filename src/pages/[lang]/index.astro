---
import HomeContent from "../../components/HomeContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { nonDefaultLocales, type Locale } from "../../i18n/languages";
import { loadTranslation, t } from "../../i18n/utils";

export function getStaticPaths() {
    return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const s = await loadTranslation(lang);
---

<BaseLayout title={`${t(s, "home.title")} — ${t(s, "home.subtitle")}`} description={t(s, "site.description")} locale={lang}>
    <HomeContent locale={lang} strings={s} />
</BaseLayout>
