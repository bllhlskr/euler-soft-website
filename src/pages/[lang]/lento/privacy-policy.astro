---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LegalShell from "../../../components/LegalShell.astro";
import LentoPrivacyContent from "../../../components/LentoPrivacyContent.astro";
import { nonDefaultLocales, type Locale } from "../../../i18n/languages";
import { loadTranslation, t } from "../../../i18n/utils";

export function getStaticPaths() {
    return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const s = await loadTranslation(lang);
const courtesyParts = t(s, "legal.courtesy").split("{link}");
---

<BaseLayout
    title={`Lento — ${t(s, "footer.privacy")}`}
    description={t(s, "site.description")}
    locale={lang}
>
    <LegalShell
        title={`Lento — ${t(s, "footer.privacy")}`}
        subtitle={t(s, "site.description")}
        courtesyBefore={courtesyParts[0]}
        courtesyAfter={courtesyParts[1]}
        courtesyHref="/lento/privacy-policy"
        courtesyLabel={t(s, "legal.courtesy.link")}
    >
        <LentoPrivacyContent />
    </LegalShell>
</BaseLayout>
