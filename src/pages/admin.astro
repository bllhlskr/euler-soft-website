---
// Owner-only admin shell. Not localized, not linked from public nav,
// excluded from indexing — access is gated by the worker admin token.
const workerOrigin = "https://card-value-scanner-identification.bllhlskr.workers.dev";
const tools = [
    { id: "cards", label: "Card Ops", description: "Cards, users, insights", path: "/admin/cards" },
    { id: "notifications", label: "Notifications", description: "Segments & campaigns", path: "/admin/notifications" },
    { id: "revenue", label: "Revenue", description: "RevenueCat analytics", path: "/admin/revenuecat" },
];
const externalLinks = [
    { label: "Worker health", href: `${workerOrigin}/health` },
    { label: "Cloudflare dashboard", href: "https://dash.cloudflare.com/3e74c25eb782937701cc55f1b6f31614" },
    { label: "Worker deploys", href: "https://github.com/bllhlskr/card-value-scanner-identification-worker/actions" },
    { label: "Site deploys", href: "https://github.com/bllhlskr/euler-soft-website/actions" },
];
const toolButtonClass =
    "tool-link flex min-h-[44px] shrink-0 flex-col justify-center rounded-xl px-4 py-2 text-start transition hover:bg-white/[0.08] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
const headerActionClass =
    "inline-flex min-h-[44px] items-center rounded-full border border-white/10 px-4 py-2 text-sm text-white/[0.58] transition hover:bg-white/[0.08] hover:text-mist focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
---

<!doctype html>
<html lang="en" dir="ltr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex, nofollow" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>Euler Soft Admin</title>
    </head>
    <body class="bg-ink font-text text-mist antialiased">
        <noscript>
            <p class="p-6 text-center text-sm text-white/70">The admin panel requires JavaScript.</p>
        </noscript>

        <p id="boot" class="flex min-h-dvh items-center justify-center text-sm text-white/50">Checking access…</p>

        <main id="gate" class="hidden min-h-dvh items-center justify-center px-6">
            <form id="login-form" class="w-full max-w-sm rounded-3xl border border-white/10 bg-panel/80 p-8 shadow-glow">
                <h1 class="font-display text-2xl font-semibold tracking-[-0.03em]">
                    Euler Soft <span class="text-sky">Admin</span>
                </h1>
                <p class="mt-2 text-sm text-white/50">Owner access only.</p>
                <label for="token-input" class="mt-6 block text-sm text-white/70">Admin token</label>
                <input
                    id="token-input"
                    type="password"
                    autocomplete="current-password"
                    required
                    class="mt-2 w-full rounded-xl border border-white/10 bg-ink px-4 py-3 text-sm text-mist placeholder:text-white/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky"
                />
                <button
                    type="submit"
                    id="login-button"
                    class="mt-4 inline-flex min-h-[44px] w-full items-center justify-center rounded-xl bg-mist px-4 py-3 text-sm font-semibold text-ink transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                >
                    Sign in
                </button>
                <p id="login-error" class="mt-3 hidden text-sm text-rose" role="alert"></p>
            </form>
        </main>

        <div id="shell" class="hidden h-dvh flex-col">
            <header class="flex items-center justify-between gap-3 border-b border-white/10 px-4 py-3 sm:px-6">
                <p class="font-display text-lg font-semibold tracking-[-0.03em]">
                    <a
                        href="/"
                        class="rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                        >Euler Soft</a
                    >
                    <span class="text-sky">Admin</span>
                </p>
                <div class="flex items-center gap-2">
                    <a id="open-tab" href={`${workerOrigin}/admin/cards`} target="_blank" rel="noopener" class={headerActionClass}>
                        Open in new tab
                    </a>
                    <button type="button" id="logout-button" class={headerActionClass}>Sign out</button>
                </div>
            </header>
            <div class="flex min-h-0 flex-1 flex-col md:flex-row">
                <aside class="flex shrink-0 flex-col border-b border-white/10 md:w-64 md:border-b-0 md:border-e">
                    <nav aria-label="Admin tools" id="tool-nav" class="flex gap-2 overflow-x-auto p-3 md:flex-col md:overflow-x-visible">
                        {tools.map((tool) => (
                            <button type="button" data-path={tool.path} class={toolButtonClass}>
                                <span class="text-sm font-medium">{tool.label}</span>
                                <span class="hidden text-xs text-white/40 md:block">{tool.description}</span>
                            </button>
                        ))}
                    </nav>
                    <div class="mt-auto hidden border-t border-white/10 p-4 md:block">
                        <p class="text-xs uppercase tracking-wide text-white/30">Shortcuts</p>
                        <ul class="mt-2 space-y-1">
                            {externalLinks.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        target="_blank"
                                        rel="noopener"
                                        class="inline-flex min-h-[36px] items-center rounded-lg px-2 py-1 text-sm text-white/[0.55] transition hover:bg-white/[0.06] hover:text-mist focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                                    >
                                        {link.label} ↗
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </aside>
                <main class="min-h-0 flex-1">
                    <iframe id="tool-frame" title="Admin tool" class="h-full w-full border-0 bg-[#eef1f3]"></iframe>
                </main>
            </div>
        </div>

        <script define:vars={{ workerOrigin }}>
            const TOKEN_KEY = "eulerOwnerToken";
            const ACTIVE_CLASSES = ["bg-white/10", "text-mist"];
            const INACTIVE_CLASSES = ["text-white/[0.58]"];

            const boot = document.getElementById("boot");
            const gate = document.getElementById("gate");
            const shell = document.getElementById("shell");
            const loginForm = document.getElementById("login-form");
            const tokenInput = document.getElementById("token-input");
            const loginButton = document.getElementById("login-button");
            const loginError = document.getElementById("login-error");
            const logoutButton = document.getElementById("logout-button");
            const openTab = document.getElementById("open-tab");
            const frame = document.getElementById("tool-frame");
            const toolButtons = Array.from(document.querySelectorAll(".tool-link"));

            let activeToken = "";

            async function verifyToken(token) {
                const response = await fetch(workerOrigin + "/v1/admin/ping", {
                    headers: { Authorization: "Bearer " + token },
                });
                return response.ok;
            }

            function showGate(message) {
                boot.classList.add("hidden");
                shell.classList.add("hidden");
                shell.classList.remove("flex");
                gate.classList.remove("hidden");
                gate.classList.add("flex");
                if (message) {
                    loginError.textContent = message;
                    loginError.classList.remove("hidden");
                } else {
                    loginError.classList.add("hidden");
                }
                tokenInput.focus();
            }

            function showShell() {
                boot.classList.add("hidden");
                gate.classList.add("hidden");
                gate.classList.remove("flex");
                shell.classList.remove("hidden");
                shell.classList.add("flex");
                selectTool(toolButtons[0]);
            }

            function selectTool(button) {
                if (!button) return;
                toolButtons.forEach((other) => {
                    const isActive = other === button;
                    other.setAttribute("aria-current", isActive ? "true" : "false");
                    ACTIVE_CLASSES.forEach((cls) => other.classList.toggle(cls, isActive));
                    INACTIVE_CLASSES.forEach((cls) => other.classList.toggle(cls, !isActive));
                });
                const url = workerOrigin + button.dataset.path;
                openTab.href = url;
                if (frame.src !== url) {
                    frame.src = url;
                }
            }

            toolButtons.forEach((button) => {
                button.addEventListener("click", () => selectTool(button));
            });

            frame.addEventListener("load", () => {
                if (activeToken && frame.contentWindow) {
                    frame.contentWindow.postMessage({ type: "cvs-admin-token", token: activeToken }, workerOrigin);
                }
            });

            loginForm.addEventListener("submit", async (event) => {
                event.preventDefault();
                const token = tokenInput.value.trim();
                if (!token) return;
                loginButton.disabled = true;
                loginButton.textContent = "Checking…";
                try {
                    if (await verifyToken(token)) {
                        activeToken = token;
                        localStorage.setItem(TOKEN_KEY, token);
                        tokenInput.value = "";
                        showShell();
                    } else {
                        showGate("That token was rejected.");
                    }
                } catch {
                    showGate("Could not reach the worker. Check your connection.");
                } finally {
                    loginButton.disabled = false;
                    loginButton.textContent = "Sign in";
                }
            });

            logoutButton.addEventListener("click", () => {
                localStorage.removeItem(TOKEN_KEY);
                window.location.reload();
            });

            (async () => {
                const saved = localStorage.getItem(TOKEN_KEY);
                if (!saved) {
                    showGate();
                    return;
                }
                try {
                    if (await verifyToken(saved)) {
                        activeToken = saved;
                        showShell();
                    } else {
                        localStorage.removeItem(TOKEN_KEY);
                        showGate("Saved token is no longer valid. Sign in again.");
                    }
                } catch {
                    showGate("Could not reach the worker. Check your connection.");
                }
            })();
        </script>
    </body>
</html>
