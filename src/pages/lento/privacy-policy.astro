---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LegalShell from "../../components/LegalShell.astro";
import LentoPrivacyContent from "../../components/LentoPrivacyContent.astro";
import en from "../../i18n/ui/en";
import { t } from "../../i18n/utils";

const s = en;
---

<BaseLayout
    title={`Lento — ${t(s, "footer.privacy")}`}
    description={t(s, "site.description")}
>
    <LegalShell title={`Lento — ${t(s, "footer.privacy")}`} subtitle={t(s, "site.description")}>
        <LentoPrivacyContent />
    </LegalShell>
</BaseLayout>
