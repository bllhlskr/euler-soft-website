---
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { apps } from "../data/apps";
import { defaultLocale, languages, type Locale } from "../i18n/languages";
import { localePath, loadTranslation, stripLocaleFromPath, t } from "../i18n/utils";

interface Props {
    title: string;
    description?: string;
    locale?: Locale;
}

const { title, description = "Euler Soft — iOS apps crafted with care.", locale = defaultLocale } = Astro.props;
const s = await loadTranslation(locale);
const dir = languages[locale].dir;
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site?.toString() ?? "https://euler-soft.com";
const normalizedPath = stripLocaleFromPath(locale, currentPath);
const canonicalUrl = new URL(currentPath, siteUrl).toString();
const defaultOgImage = new URL("/images/blood-sugar-tracker.png", siteUrl).toString();
const navLinkClass = "inline-flex min-h-[44px] items-center rounded-full px-4 py-2 text-sm text-white/[0.58] transition hover:bg-white/[0.08] hover:text-mist focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
const footerLinkClass = "inline-flex min-h-[44px] items-center rounded-full px-3 py-2 transition hover:bg-white/[0.05] hover:text-mist focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
const ogLocaleByLanguage: Record<Locale, string> = {
    en: "en_US",
    tr: "tr_TR",
    de: "de_DE",
    fr: "fr_FR",
    es: "es_ES",
    it: "it_IT",
    pt: "pt_BR",
    ja: "ja_JP",
    ko: "ko_KR",
    zh: "zh_CN",
    ar: "ar_SA",
    da: "da_DK",
    fi: "fi_FI",
    he: "he_IL",
    id: "id_ID",
    nl: "nl_NL",
    nb: "nb_NO",
    pl: "pl_PL",
    ru: "ru_RU",
    sv: "sv_SE",
    th: "th_TH",
    uk: "uk_UA",
    vi: "vi_VN",
};
const structuredData = JSON.stringify([
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Euler Soft",
        url: siteUrl,
        logo: new URL("/favicon.svg", siteUrl).toString(),
        contactPoint: {
            "@type": "ContactPoint",
            email: "eulersoft@outlook.com",
            contactType: "customer support",
            availableLanguage: Object.keys(languages),
        },
    },
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Euler Soft iOS Apps",
        itemListElement: apps.map((app, index) => ({
            "@type": "SoftwareApplication",
            position: index + 1,
            name: app.name,
            applicationCategory: app.category,
            operatingSystem: "iOS",
            url: app.appStoreUrl,
            image: new URL(app.icon, siteUrl).toString(),
        })),
    },
]);
---

<!doctype html>
<html lang={locale} dir={dir}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={defaultOgImage} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content={ogLocaleByLanguage[locale]} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={defaultOgImage} />
        <link rel="alternate" hreflang="x-default" href={new URL(normalizedPath, siteUrl).toString()} />
        {Object.keys(languages).map((lang) => (
            <link
                rel="alternate"
                hreflang={lang}
                href={new URL(localePath(lang as Locale, normalizedPath), siteUrl).toString()}
            />
        ))}
        <script type="application/ld+json" set:html={structuredData}></script>
        <title>{title}</title>
    </head>
    <body class="bg-ink font-text text-mist antialiased">
        <a
            href="#main-content"
            class="sr-only fixed start-4 top-4 z-[60] rounded-full bg-mist px-4 py-3 text-sm font-medium text-ink focus:not-sr-only focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-white"
        >
            Skip to main content
        </a>
        <header class="sticky top-0 z-50 px-4 pb-2 pt-3 sm:px-6">
            <nav class="mx-auto flex max-w-shell items-center justify-between gap-4 rounded-full border border-white/10 bg-ink/70 px-4 py-3 shadow-glow backdrop-blur-2xl sm:px-6">
                <a
                    href={localePath(locale)}
                    class="inline-flex min-h-[44px] items-center rounded-full px-3 py-2 font-display text-lg font-semibold tracking-[-0.03em] text-mist focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                >
                    Euler Soft
                </a>
                <div class="flex items-center gap-2 sm:gap-3">
                    <a href={localePath(locale, "/support")} class={navLinkClass}>{t(s, "nav.support")}</a>
                    <a href={localePath(locale, "/contact")} class={navLinkClass}>{t(s, "nav.contact")}</a>
                    <div class="hidden items-center gap-2 lg:flex">
                        <a href={localePath(locale, "/privacy-policy")} class={navLinkClass}>{t(s, "nav.privacy")}</a>
                        <a href={localePath(locale, "/terms-of-use")} class={navLinkClass}>{t(s, "nav.terms")}</a>
                    </div>
                    <LanguageSwitcher currentLocale={locale} currentPath={currentPath} />
                </div>
            </nav>
        </header>

        <main id="main-content" class="min-h-[70vh]">
            <slot />
        </main>

        <footer class="mt-24 border-t border-white/10">
            <div class="mx-auto flex max-w-shell flex-col gap-6 px-6 py-10 text-sm text-white/[0.48] sm:flex-row sm:items-center sm:justify-between">
                <p>{t(s, "footer.copyright", { year: new Date().getFullYear().toString() })}</p>
                <div class="flex flex-wrap justify-center gap-2 sm:justify-end">
                    <a href={localePath(locale, "/support")} class={footerLinkClass}>{t(s, "nav.support")}</a>
                    <a href={localePath(locale, "/contact")} class={footerLinkClass}>{t(s, "footer.contact")}</a>
                    <a href={localePath(locale, "/privacy-policy")} class={footerLinkClass}>{t(s, "footer.privacy")}</a>
                    <a href={localePath(locale, "/terms-of-use")} class={footerLinkClass}>{t(s, "footer.terms")}</a>
                </div>
            </div>
        </footer>

        <style is:global>
            :root {
                color-scheme: dark;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                background:
                    radial-gradient(circle at top, rgba(89, 208, 255, 0.16), transparent 28rem),
                    radial-gradient(circle at 80% 0%, rgba(120, 121, 255, 0.16), transparent 28rem),
                    linear-gradient(180deg, #05070b 0%, #070b12 36%, #090d16 100%);
            }

            body::before {
                content: "";
                pointer-events: none;
                position: fixed;
                inset: 0;
                background-image:
                    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
                background-position: center;
                background-size: 72px 72px;
                mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.36), transparent 80%);
                opacity: 0.18;
                z-index: -1;
            }

            ::selection {
                background: rgba(89, 208, 255, 0.32);
                color: #f5f7fb;
            }

            summary::-webkit-details-marker {
                display: none;
            }
        </style>
    </body>
</html>
