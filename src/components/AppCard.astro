---
import type { AppTheme } from "../data/apps";
import { getAppThemeClasses } from "../data/appThemes";

interface Props {
    name: string;
    icon: string;
    description: string;
    appStoreUrl: string;
    category: string;
    theme: AppTheme;
    ctaLabel: string;
}

const { name, icon, description, appStoreUrl, category, theme, ctaLabel } = Astro.props;
const themeClasses = getAppThemeClasses(theme);
---

<a
    href={appStoreUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="group relative block h-full overflow-hidden rounded-[32px] border border-white/10 bg-white/[0.04] p-6 shadow-glow backdrop-blur-xl transition duration-500 hover:-translate-y-1.5 hover:border-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
>
    <div class={`absolute inset-0 bg-gradient-to-br ${themeClasses.aura} opacity-90 transition duration-500 group-hover:scale-110`}></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
    <div class="relative flex h-full flex-col">
        <div class="flex items-center justify-between gap-4">
            <span class={`inline-flex min-h-[36px] items-center rounded-full border px-3 py-1 text-[0.68rem] font-medium uppercase tracking-[0.28em] ${themeClasses.chip}`}>
                {category}
            </span>
            <span class="text-[0.72rem] uppercase tracking-[0.28em] text-white/[0.45]">iOS</span>
        </div>

        <div class="mt-8 flex items-start gap-5">
            <div class="relative shrink-0 overflow-hidden rounded-[26px] border border-white/10 bg-white/90 p-3 shadow-card">
                <div class={`absolute inset-0 bg-gradient-to-br ${themeClasses.iconGlow}`}></div>
                <img
                    src={icon}
                    alt={`${name} icon`}
                    width="88"
                    height="88"
                    class="relative h-[88px] w-[88px] rounded-[20px]"
                    loading="lazy"
                />
            </div>

            <div class="min-w-0">
                <h3 class={`font-display text-2xl font-semibold tracking-[-0.03em] text-mist transition-colors duration-300 ${themeClasses.accentText}`}>
                    {name}
                </h3>
                <p class="mt-3 text-sm leading-7 text-white/[0.68] sm:text-[0.95rem]">{description}</p>
            </div>
        </div>

        <div class={`mt-8 flex items-center justify-between border-t pt-5 text-sm text-white/[0.55] ${themeClasses.divider}`}>
            <span class="inline-flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-white/[0.6]"></span>
                App Store
            </span>
            <span class={`inline-flex items-center gap-2 font-medium text-mist transition-transform duration-300 group-hover:translate-x-1 ${themeClasses.accentText}`}>
                {ctaLabel}
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14m0 0-5-5m5 5-5 5" />
                </svg>
            </span>
        </div>
    </div>
</a>
