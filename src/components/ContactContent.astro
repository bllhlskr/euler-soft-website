---
import { apps } from "../data/apps";
import type { Locale } from "../i18n/languages";
import { localePath, t } from "../i18n/utils";

interface Props {
    locale: Locale;
    strings: Record<string, string>;
}

const { locale, strings: s } = Astro.props;
const sendingText = JSON.stringify(t(s, "contact.form.sending"));
const fallbackSubject = JSON.stringify(t(s, "contact.form.subject"));
const returnUrl = `https://euler-soft.com${localePath(locale, "/contact")}`;
---

<section class="pt-10 sm:pt-14">
    <div class="mx-auto max-w-shell px-6">
        <div class="relative overflow-hidden rounded-[40px] border border-white/10 bg-white/[0.04] px-6 py-12 shadow-glow backdrop-blur-2xl sm:px-10 sm:py-16">
            <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-white/[0.22] to-transparent"></div>
            <div class="absolute -start-20 top-8 h-72 w-72 rounded-full bg-rose/[0.16] blur-3xl"></div>
            <div class="absolute end-10 top-0 h-72 w-72 rounded-full bg-sky/[0.16] blur-3xl"></div>

            <div class="relative grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(20rem,0.7fr)] lg:items-end">
                <div class="max-w-3xl">
                    <span class="inline-flex min-h-[36px] items-center rounded-full border border-white/[0.12] bg-white/[0.06] px-4 py-1 text-[0.68rem] uppercase tracking-[0.3em] text-white/[0.6]">
                        {t(s, "contact.title")}
                    </span>
                    <h1 class="mt-6 font-display text-4xl font-semibold tracking-[-0.05em] text-mist sm:text-6xl">
                        {t(s, "contact.title")}
                    </h1>
                    <p class="mt-4 max-w-2xl text-base leading-8 text-white/[0.72] sm:text-lg">
                        {t(s, "contact.subtitle")}
                    </p>
                </div>

                <div class="flex flex-wrap gap-3">
                    {apps.slice(0, 5).map((app) => (
                        <div class="rounded-[22px] border border-white/10 bg-white/[0.06] p-3">
                            <img src={app.icon} alt="" width="64" height="64" class="h-14 w-14 rounded-[16px] shadow-card" loading="lazy" />
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pb-24 pt-8">
    <div class="mx-auto max-w-shell px-6">
        <div class="grid gap-6 xl:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)]">
            <div class="rounded-[36px] border border-white/10 bg-white/[0.04] p-6 shadow-glow backdrop-blur-2xl sm:p-8">
                <form
                    action="https://formsubmit.co/eulersoft@outlook.com"
                    method="POST"
                    class="space-y-5"
                    id="contact-form"
                >
                    <input type="hidden" name="_captcha" value="false" />
                    <input type="hidden" name="_next" value={returnUrl} />
                    <input type="hidden" name="_subject" value="Euler Soft Contact Form" />
                    <input type="text" name="_honey" style="display:none" />

                    <div class="grid gap-5 md:grid-cols-2">
                        <label class="block text-sm font-medium text-white/[0.72]">
                            <span class="mb-2 block">{t(s, "contact.form.name")}</span>
                            <input
                                type="text"
                                name="name"
                                id="name"
                                required
                                class="w-full rounded-[24px] border border-white/10 bg-ink/60 px-4 py-3.5 text-mist placeholder:text-white/[0.28] transition focus:border-white/[0.28] focus:outline-none"
                            />
                        </label>

                        <label class="block text-sm font-medium text-white/[0.72]">
                            <span class="mb-2 block">{t(s, "contact.form.email")}</span>
                            <input
                                type="email"
                                name="email"
                                id="email"
                                required
                                class="w-full rounded-[24px] border border-white/10 bg-ink/60 px-4 py-3.5 text-mist placeholder:text-white/[0.28] transition focus:border-white/[0.28] focus:outline-none"
                            />
                        </label>
                    </div>

                    <div class="grid gap-5 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
                        <label class="block text-sm font-medium text-white/[0.72]">
                            <span class="mb-2 block">{t(s, "contact.form.app")}</span>
                            <select
                                name="app"
                                id="app"
                                class="w-full rounded-[24px] border border-white/10 bg-ink/60 px-4 py-3.5 text-mist transition focus:border-white/[0.28] focus:outline-none"
                            >
                                <option value="">{t(s, "contact.form.app.none")}</option>
                                {apps.map((app) => (
                                    <option value={t(s, `app.${app.slug}.name`)}>{t(s, `app.${app.slug}.name`)}</option>
                                ))}
                            </select>
                        </label>

                        <label class="block text-sm font-medium text-white/[0.72]">
                            <span class="mb-2 block">{t(s, "contact.form.subject")}</span>
                            <input
                                type="text"
                                name="subject"
                                id="subject"
                                required
                                class="w-full rounded-[24px] border border-white/10 bg-ink/60 px-4 py-3.5 text-mist placeholder:text-white/[0.28] transition focus:border-white/[0.28] focus:outline-none"
                            />
                        </label>
                    </div>

                    <label class="block text-sm font-medium text-white/[0.72]">
                        <span class="mb-2 block">{t(s, "contact.form.message")}</span>
                        <textarea
                            name="message"
                            id="message"
                            rows="7"
                            required
                            class="w-full rounded-[28px] border border-white/10 bg-ink/60 px-4 py-3.5 text-mist placeholder:text-white/[0.28] transition focus:border-white/[0.28] focus:outline-none"
                        ></textarea>
                    </label>

                    <button
                        type="submit"
                        class="inline-flex min-h-[54px] w-full items-center justify-center rounded-full bg-mist px-6 py-3 text-sm font-medium text-ink transition hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white disabled:cursor-not-allowed disabled:bg-white/50"
                    >
                        {t(s, "contact.form.send")}
                    </button>
                </form>

                <div
                    id="form-success"
                    class="hidden mt-6 rounded-[28px] border border-mint/[0.3] bg-mint/10 p-5 text-center"
                    aria-live="polite"
                >
                    <p class="font-medium text-mint">{t(s, "contact.form.success")}</p>
                </div>
            </div>

            <div class="space-y-6">
                <div class="rounded-[32px] border border-white/10 bg-white/[0.04] p-6 shadow-glow backdrop-blur-2xl">
                    <p class="text-sm uppercase tracking-[0.3em] text-white/[0.45]">{t(s, "contact.email.label")}</p>
                    <a
                        href="mailto:eulersoft@outlook.com"
                        class="mt-5 inline-flex break-all font-display text-3xl font-semibold tracking-[-0.04em] text-mist transition hover:text-sky focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                    >
                        eulersoft@outlook.com
                    </a>
                    <p class="mt-4 text-sm leading-7 text-white/[0.65]">{t(s, "contact.email.description")}</p>
                </div>

                <div class="rounded-[32px] border border-white/10 bg-white/[0.04] p-6 shadow-glow backdrop-blur-2xl">
                    <p class="text-sm uppercase tracking-[0.3em] text-white/[0.45]">{t(s, "support.title")}</p>
                    <p class="mt-4 font-display text-3xl font-semibold tracking-[-0.04em] text-mist">48h</p>
                    <p class="mt-3 text-sm leading-7 text-white/[0.65]">{t(s, "contact.response")}</p>
                </div>

                <div class="rounded-[32px] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.07),rgba(255,255,255,0.03))] p-6 shadow-glow backdrop-blur-2xl">
                    <p class="text-sm uppercase tracking-[0.3em] text-white/[0.45]">{t(s, "nav.support")}</p>
                    <p class="mt-4 text-sm leading-7 text-white/[0.65]">{t(s, "support.subtitle")}</p>
                    <a
                        href={localePath(locale, "/support")}
                        class="mt-6 inline-flex min-h-[48px] items-center rounded-full border border-white/[0.12] bg-white/[0.06] px-5 py-3 text-sm font-medium text-mist transition hover:bg-white/[0.1] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                    >
                        {t(s, "nav.support")}
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        const sendingText = {sendingText};
        const fallbackSubject = {fallbackSubject};
        const form = document.getElementById("contact-form") as HTMLFormElement | null;
        const successMsg = document.getElementById("form-success");

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = form.querySelector<HTMLButtonElement>("button[type=submit]");
            if (!btn) return;
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = sendingText;

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                    headers: { Accept: "application/json" },
                });

                if (response.ok) {
                    form.style.display = "none";
                    successMsg?.classList.remove("hidden");
                } else {
                    window.location.href = `mailto:eulersoft@outlook.com?subject=${encodeURIComponent(
                        form.querySelector<HTMLInputElement>("#subject")?.value ?? fallbackSubject
                    )}&body=${encodeURIComponent(
                        form.querySelector<HTMLTextAreaElement>("#message")?.value ?? ""
                    )}`;
                }
            } catch {
                window.location.href = "mailto:eulersoft@outlook.com";
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        });
    </script>
</section>
